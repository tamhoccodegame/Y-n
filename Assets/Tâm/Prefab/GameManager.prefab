--- !u!114 &7654417887365070592
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5062390808564553049}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c1a4e7361e2dfe340b88ddb76534f469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  costumeList:
  - costumeName: "C\xF2 \xC1o B\xE0 Ba"
    costumeSprite: {fileID: 21300000, guid: 90ae1e363e779c44383e23120ab661d1, type: 3}
    costumerInform: "\xC1o b\xE0 b\xE0 l\xE0 trang ph\u1EE5c truy\u1EC1n th\u1ED1ng
      c\u1EE7a ng\u01B0\u1EDDi d\xE2n mi\u1EC1n Nam B\u1ED9 Vi\u1EC7t Nam."
  - costumeName: "C\xF2 \xC1o Ch\xE0m"
    costumeSprite: {fileID: 21300000, guid: 2196da45a69182b49bbcc26931caa0ff, type: 3}
    costumerInform: " \xC1o ch\xE0m l\xE0 m\u1ED9t lo\u1EA1i trang ph\u1EE5c truy\u1EC1n
      th\u1ED1ng c\u1EE7a c\xE1c d\xE2n t\u1ED9c thi\u1EC3u s\u1ED1 \u1EDF Vi\u1EC7t
      Nam, \u0111\u1EB7c bi\u1EC7t l\xE0 d\xE2n t\u1ED9c T\xE0y, N\xF9ng, v\xE0 H'm\xF4ng."
  - costumeName: "C\xF2 \xC1o th\u1EE5ng"
    costumeSprite: {fileID: 21300000, guid: 599f681b2a260da41ae000f95de6c26f, type: 3}
    costumerInform: "\xC1o th\u1EE5ng, hay c\xF2n g\u1ECDi l\xE0 \xE1o th\u1EE5ng
      (\xE1o th\u1EE5ng) \u1EDF mi\u1EC1n B\u1EAFc Vi\u1EC7t Nam, l\xE0 m\u1ED9t
      lo\u1EA1i trang ph\u1EE5c truy\u1EC1n th\u1ED1ng c\u1EE7a ng\u01B0\u1EDDi Vi\u1EC7t,
      th\u01B0\u1EDDng \u0111\u01B0\u1EE3c l\xE0m t\u1EEB v\u1EA3i m\u1EC1m, nh\u1EB9,
      v\xE0 c\xF3 thi\u1EBFt k\u1EBF tho\u1EA3i m\xE1i. "
